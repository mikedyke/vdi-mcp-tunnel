<idea-plugin>
    <id>com.vditunnel.bridge</id>
    <name>VDI Tunnel Bridge</name>
    <vendor>internal</vendor>
    <description><![CDATA[
        Air-gap MCP bridge: renders MCP responses as QR and receives typed MCP requests,
        relaying to the IDE's built-in MCP server on localhost. In-house tool — not for Marketplace.
    ]]></description>

    <!-- 252 = 2025.2, 261 = 2026.1, 262 = 2026.2. Built against 2026.1 (gradle.properties);
         the range stays wide because the plugin uses only long-stable platform APIs. -->
    <idea-version since-build="252" until-build="262.*"/>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="VDI Tunnel" anchor="right"
                    factoryClass="com.vditunnel.bridge.TunnelToolWindowFactory"/>
    </extensions>
</idea-plugin>
